# Copy this file to .env for local testing (never commit the real .env).
# On Render, set these as Environment Variables in the dashboard instead of a file.

# Your Discord webhook URL (Server Settings > Integrations > Webhooks in Discord)
DISCORD_WEBHOOK_URL=

# A secret string you make up yourself. Roblox must send this in the
# x-api-key header on every request, so randoms who find your server URL
# can't spam your Discord. Generate one with: openssl rand -hex 24
API_TOKEN=
